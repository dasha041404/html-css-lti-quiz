# Адрес приложения на Render (без слэша в конце). На Render можно не задавать:
# подставится RENDER_EXTERNAL_URL.
PUBLIC_URL=https://html-css-lti-quiz.onrender.com

# Строка подключения MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lti_quiz?retryWrites=true&w=majority
MONGODB_DB=lti_quiz

# Значения из Moodle: Управление инструментами -> «Просмотр деталей конфигурации»
MOODLE_ISSUER=https://dasaveleva.gnomio.com
MOODLE_CLIENT_ID=
MOODLE_DEPLOYMENT_ID=

# Необязательно. По умолчанию строятся от MOODLE_ISSUER:
# MOODLE_AUTH_URL=https://dasaveleva.gnomio.com/mod/lti/auth.php
# MOODLE_TOKEN_URL=https://dasaveleva.gnomio.com/mod/lti/token.php
# MOODLE_JWKS_URL=https://dasaveleva.gnomio.com/mod/lti/certs.php
